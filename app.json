{
  "expo": {
    "name": "project_224004U",
    "slug": "project_224004U",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "src/components/ui/logo.png",
    "scheme": "project224004u",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.yourapp",
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/components/ui/logo.png",
        "backgroundColor": "#0f0520"
      },
      "statusBar": {
        "backgroundColor": "#0f0520",
        "barStyle": "light-content"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "src/components/ui/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "splash": {
      "image": "src/components/ui/logo.png",
      "backgroundColor": "#0f0520",
      "resizeMode": "contain"
    }
  }
}
